{
    "name": "My Projects Link Redirect",
    "description": "Change links on My Projects page to point to a custom landing page for specified users.",
    "namespace": "Vanderbilt\\MyProjectsLinkRedirect\\ExternalModule",
    "documentation": "README.md",
    "enable-every-page-hooks-on-system-pages": true,
    "framework-version": 16,
    "authors": [
        {
            "name": "Kyle Chesney",
            "email": "datacore@vumc.org",
            "institution": "Vanderbilt University Medical Center"
        }
    ],
    "system-settings": [
        {
            "key": "redirs",
            "name": "Redirects",
            "type": "sub_settings",
            "repeatable":true,
            "sub_settings":[
                {
                    "key": "target_project",
                    "name": "Project to Redirect",
                    "type": "project-id"
                },
                {
                    "key": "redirect_link",
                    "name": "Redirect Link",
                    "type": "text"
                },
                {
                    "key": "user_list",
                    "name": "Users to Redirect",
                    "type": "dropdown",
                    "choices": [],
                    "repeatable": true,
                    "autocomplete": true
                },
                {
                    "key": "custom_link_css",
                    "name": "Custom Link CSS",
                    "type": "json"
                }
            ]
        }
    ]
}
